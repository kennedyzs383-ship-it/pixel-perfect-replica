# URL pública do projeto Supabase
VITE_SUPABASE_URL=https://emcdkxxmfqgejfmfpxwe.supabase.co

# Chave publishable (sb_publishable_...) ou a antiga anon key.
# Nunca colocar aqui service_role, secret key ou qualquer chave privada.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Modelo Z Router opcional (identificador exato do catálogo da tua conta).
# A chave privada ZROUTER_API_KEY deve ficar apenas em Lovable → Secrets.
ZROUTER_MODEL=openrouter/google/gemini-2.5-flash
